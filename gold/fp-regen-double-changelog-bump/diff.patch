+/**
+ * Инвариант генератора индекса роутов: «тело документа изменилось → `Версия:` выросла».
+ * Он не косметический — ops/check-doc-version-bump.sh валит PR, где документ корпуса
+ * изменён без подъёма версии, и обхода у гейта нет. Пока генератор печатал `Версия: 1.0`
+ * литералом, любой PR с новым роутом был красным намертво (PR #516), а ручной бамп
+ * затирался следующей регенерацией — гейт видел уже понижение.
+ *
+ * Второй охраняемый инвариант: смена суток не должна ничего трогать, иначе `--check`
+ * в CI и pre-commit краснели бы каждую полночь.
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const GEN_SRC = path.join(HERE, 'gen-api-routes-doc.mjs');
+
+const { planDoc, bumpMinor, parseFrontmatterVersion, parseChangelogRows, normalizeForCheck } =
+  await import('./gen-api-routes-doc.mjs');
+
+/** @param {Record<string, [string[], string[]]>} spec route → [методы, модули] */
+function routes(spec) {
+  return new Map(
+    Object.entries(spec).map(([route, [methods, files]]) => [
+      route,
+      { methods: new Set(methods), files: new Set(files) },
+    ]),
+  );
+}
+
+const BASE_ROUTES = routes({
+  '/api/records': [['GET', 'POST'], ['records.ts']],
+  '/api/records/:id': [['PUT'], ['records.ts']],
+});
+
+// ---------------------------------------------------------------- чистые функции
+
+test('gen-api-doc: файла нет → версия 1.0 и одна строка changelog', () => {
+  const plan = planDoc({ existing: null, byRoute: BASE_ROUTES, today: '2026-01-01' });
+
+  assert.equal(plan.status, 'created');
+  assert.equal(plan.version, '1.0');
+  assert.equal(parseFrontmatterVersion(plan.content), '1.0');
+  assert.equal(parseChangelogRows(plan.content).length, 1);
+});
+
+test('gen-api-doc: тело не изменилось → версия та же и файл байт в байт', () => {
+  const existing = planDoc({ existing: null, byRoute: BASE_ROUTES, today: '2026-01-01' }).content;
+
+  const plan = planDoc({ existing, byRoute: BASE_ROUTES, today: '2026-01-01' });
+
+  assert.equal(plan.status, 'unchanged');
+  assert.equal(plan.version, '1.0');
+  assert.equal(plan.content, existing);
+});
+
+test('gen-api-doc: поднятую руками версию регенерация не откатывает', () => {
+  const existing = planDoc({ existing: null, byRoute: BASE_ROUTES, today: '2026-01-01' })
+    .content.replace('Версия: 1.0', 'Версия: 1.7');
+
+  const plan = planDoc({ existing, byRoute: BASE_ROUTES, today: '2026-01-01' });
+
+  assert.equal(plan.status, 'unchanged');
+  assert.equal(plan.version, '1.7');
+  assert.equal(parseFrontmatterVersion(plan.content), '1.7');
+});
+
+test('gen-api-doc: тело изменилось → минор ровно +1, прежние строки changelog целы', () => {
+  const existing = planDoc({ existing: null, byRoute: BASE_ROUTES, today: '2026-01-01' }).content;
+  const oldRows = parseChangelogRows(existing);
+
+  const withNewRoute = routes({
+    '/api/records': [['GET', 'POST'], ['records.ts']],
+    '/api/records/:id': [['PUT'], ['records.ts']],
+    '/api/voucher/summary': [['GET'], ['voucher.ts']],
+  });
+  const plan = planDoc({ existing, byRoute: withNewRoute, today: '2026-02-02' });
+
+  assert.equal(plan.status, 'updated');
+  assert.equal(plan.version, '1.1');
+  assert.equal(parseFrontmatterVersion(plan.content), '1.1');
+
+  const rows = parseChangelogRows(plan.content);
+  assert.equal(rows.length, oldRows.length + 1);
+  assert.match(rows[0], /^\| 1\.1 \| 2026-02-02 \|/); // новая запись сверху, как в остальном корпусе
+  assert.deepEqual(rows.slice(1), oldRows); // история дословно перенесена
+  assert.ok(plan.content.includes('`/api/voucher/summary`'));
+});
+
+test('gen-api-doc: сменились только сутки → версия не растёт', () => {
+  const existing = planDoc({ existing: null, byRoute: BASE_ROUTES, today: '2026-01-01' }).content;
+
+  const plan = planDoc({ existing, byRoute: BASE_ROUTES, today: '2026-12-31' });
+
+  assert.equal(plan.status, 'unchanged');
+  assert.equal(plan.version, '1.0');
+  assert.equal(normalizeForCheck(plan.content), normalizeForCheck(existing));
+});
+
+test('gen-api-doc: минор считается числом — 1.9 → 1.10 (гейт сравнивает покомпонентно)', () => {
+  assert.equal(bumpMinor('1.0'), '1.1');
+  assert.equal(bumpMinor('1.9'), '1.10');
+  assert.equal(bumpMinor('1.10'), '1.11');
+  assert.equal(bumpMinor('2'), '2.1');
+});
+
+test('gen-api-doc: версия читается только из головного frontmatter, не из таблицы changelog', () => {
+  const noHeader = ['# Doc', '', '## Changelog', '', '| Версия | Дата | Изменение |', '| 1.5 | 2026-01-01 | x |'].join('\n');
+  assert.equal(parseFrontmatterVersion(noHeader), null);
+  assert.equal(parseFrontmatterVersion('---\nДокумент: x\n---\nВерсия: 9.9\n'), null);
+  assert.equal(parseFrontmatterVersion('---\nВерсия: 1.x\n---\n'), null); // не число — не версия
+  assert.equal(parseFrontmatterVersion('---\nВерсия: 1.2.3\n---\n'), '1.2.3');
