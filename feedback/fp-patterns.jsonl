{"id":"e2e-in-diff","description":"e2e spec в диффе, но модель пишет «нет e2e»","regex":"(?:e2e|playwright)[^.]{0,25}(?:^|\\s)(?:нет|отсутствует|без|не\\s+добавлен[а-я]*)(?=\\s|$)|(?:^|\\s)(?:нет|отсутствует|без|не\\s+добавлен[а-я]*)(?=\\s)[^.]{0,25}(?:e2e|playwright)|\\b(?:no|missing)\\s+(?:e2e|playwright)(?:\\s+tests?)?\\b|\\b(?:e2e|playwright)\\s+tests?\\s+(?:not\\s+added|missing|absent)\\b","requiresPath":"(?:^|/)e2e/.*\\.spec\\.ts$"}
{"id":"file-absent-in-diff","description":"модель: файл не в PR, но basename есть в тексте и в changedPaths","regex":"(?:^|\\s)файл(?=\\s).{0,30}?(?:отсутствует\\s+в|не\\s+(?:входит\\s+в|найден\\s+в|в))\\s+(?:дифф\\w*|pr\\b)|\\bfile\\b.{0,30}?(?:(?:not\\s+in|absent\\s+from|not\\s+found\\s+in|missing\\s+from|missing\\s+in)\\s+(?:the\\s+)?(?:pr|diff))\\b","matchChangedBasename":true}
{"id":"gha-version-hallucination","description":"модель утверждает что пин GitHub Action не существует (устаревшие знания; ci.yml уже использует v6/v7)","regex":"(?:actions/(?:checkout|setup-node|setup-python|cache|upload-artifact)|github/codeql-action/upload-sarif)@v\\d+.{0,40}(?:версия\\s+не\\s+существует|не\\s+существует|workflow\\s+упад|может\\s+не\\s+существовать|does\\s+not\\s+exist)|(?:версия\\s+не\\s+существует|не\\s+существует|может\\s+не\\s+существовать).{0,30}(?:actions/(?:checkout|setup-node|setup-python|cache|upload-artifact)|github/codeql-action/upload-sarif)@v\\d+","requiresPath":"\\.github/workflows/"}
{"id":"metrics-absent-observability","description":"модель: метрики не существуют/не определены — но источник textfile-collector/remote_write вне scrape_configs (PR #477, локальный прогон)","regex":"(?:метрик[а-яё]*|metrics).{0,50}(?:не\\s+(?:существует|определ[а-яё]*|найден[а-яё]*|приход[а-яё]*)|отсутству[а-яё]*)|отсутствующие\\s+(?:метрик[а-яё]*|metrics)|(?:метрик[а-яё]*|metrics)\\s+(?:does\\s+not\\s+exist|not\\s+defined)","requiresPath":"ops/observability/"}
{"id":"softblast-typedef-cosmetic","description":"косметика: typedef Finding / softBlast dual-field — не дефект поведения (verifier-rejected dry-run 2026-08-30)","regex":"(?:typedef\\s+Finding\\s+не\\s+описывает\\s+blast-radius|softBlast\\s+дублирует\\s+проверку\\s+через\\s+два\\s+поля)|(?:Finding\\s+typedef).{0,40}(?:blastCaller|blast-radius\\s+marker)|softBlast.{0,30}(?:two\\s+fields|dual|дублир)","requiresPath":"(?:^|/)(?:lib/findings\\.mjs|lib/blast-findings\\.mjs)$"}
{"id":"graphify-path-norm-speculation","description":"спекуляция о разных формах путей graphify без доказательств в коде (verifier-rejected dry-run 2026-08-30)","regex":"(?:[Дд]едуп\\s+по\\s+`?d\\.file`?\\s+без\\s+нормализации\\s+пути)|(?:разных\\s+представлениях\\s+путей\\s+от\\s+graphify)|(?:path\\s+normalization).{0,40}(?:graphify|blast).{0,40}(?:without\\s+evidence|speculat)","requiresPath":"(?:^|/)lib/graphify\\.mjs$"}
{"id":"graphify-depth-shell-injection","description":"гипотеза CLI-injection через REVIEW_GRAPHIFY_DEPTH при том что вызов — execFile+argv (dry-run 2026-08-30)","regex":"(?:command-injection|command\\s+injection|инъекц[а-яё]*\\s+команд).{0,60}(?:REVIEW_GRAPHIFY_DEPTH|graphify\\s+affected|--depth)|(?:REVIEW_GRAPHIFY_DEPTH|--depth).{0,60}(?:shell:\\s*true|exec\\s*\\(|интерполяц)","requiresPath":"(?:^|/)(?:docs/configuration\\.md|lib/graphify\\.mjs)$"}
{"id":"blast-source-literal-softblast","description":"BLAST_FINDING_SOURCE / softConsensusForBlastCluster — осознанная soft-tier политика, не молчаливый отказ (dry-run 2026-08-30)","regex":"(?:[Зз]ахардкоженн[а-яё]*\\s+литерал\\s+['\"]blast-radius['\"]|softBlast|softConsensusForBlastCluster|BLAST_FINDING_SOURCE|f\\.source\\s*===\\s*['\"]blast-radius['\"]).{0,80}(?:generic\\s+core|молчалив|дублир|clusterFindings)","requiresPath":"(?:^|/)lib/findings\\.mjs$"}
{"id":"parse-blast-dependents-export-exists","description":"кросс-чанк шум: parseBlastDependents экспортируется из blast-findings (dry-run 2026-08-30)","regex":"(?:[Ээ]кспорт\\s+parseBlastDependents|parseBlastDependents).{0,80}(?:ANOTHER\\s+PART|не\\s+экспортируется|SyntaxError)","requiresPath":"(?:^|/)index\\.mjs$"}
{"id":"costtracker-engine-deps-intentional","description":"costTracker намеренно в createLlmClient, не в createReviewEngine (dry-run 2026-08-30)","regex":"(?:[Уу]далён\\s+costTracker\\s+из\\s+deps\\s+createReviewEngine|costTracker).{0,60}(?:createReviewEngine|требуется\\s+верификац)","requiresPath":"(?:^|/)pipeline\\.mjs$"}
{"id":"graphify-symbol-dash-flag-fp","description":"символ с ведущим `-` не CLI-флаг: graphify берёт argv[2] как query, вызов через execFile (dry-run 2026-08-30)","regex":"(?:символ|symbol).{0,40}(?:начинается\\s+с\\s+['\"]?-|leading\\s+dash|looks\\s+like\\s+(?:a\\s+)?(?:CLI\\s+)?flag)|(?:CLI\\s+flag|--).{0,40}(?:affected|graphify).{0,40}(?:символ|symbol)","requiresPath":"(?:^|/)lib/graphify\\.mjs$"}
{"id":"softblast-module-boundary-intentional","description":"литерал blast-radius в findings — осознанная soft-tier граница, не нарушение модулей (dry-run 2026-08-30)","regex":"(?:[Нн]арушение\\s+границ\\s+модул|module\\s+boundary|hardcod).{0,80}(?:blast-radius|softBlast|soft-tier)|(?:blast-radius).{0,60}(?:границ\\s+модул|module\\s+boundary)","requiresPath":"(?:^|/)lib/findings\\.mjs$"}
{"id":"redact-vs-obs-duplicate-ok","description":"redactSecretsForLog в util + observability — намеренный shared helper, не дубль логики (dry-run 2026-08-30)","regex":"(?:redactSecretsForLog|дублир[а-яё]*\\s+redact|duplicate\\s+redact).{0,60}(?:observability|util\\.mjs)|(?:observability).{0,40}(?:redact|маск).{0,40}(?:дубл|duplicate)","requiresPath":"(?:^|/)(?:lib/util\\.mjs|lib/observability\\.mjs)$"}
{"id":"fp-findings-cluster-intentional","description":"несколько softblast FP на findings.mjs — накопленный learning, не маскировка долга (dry-run 2026-08-30)","regex":"(?:[Тт]ри\\s+FP-паттерн|три\\s+паттерн|концентрац[а-яё]*\\s+(?:трёх|трех|трёх\\s+таких)|FP-паттерн[а-яё]*\\s+подряд).{0,80}(?:findings\\.mjs|softblast|blast-radius)|(?:глушат|маскир).{0,40}(?:архитектурн|findings\\.mjs)","requiresPath":"(?:^|/)feedback/fp-patterns\\.jsonl$"}
{"id":"crosschunk-filterFindingsFixedInDiff","description":"кросс-чанк: filterFindingsFixedInDiff экспортируется из findings (dry-run 2026-08-30)","regex":"(?:filterFindingsFixedInDiff).{0,80}(?:должен\\s+экспортир|не\\s+экспортир|эквивалентн|семантик)|(?:Зависимость:\\s*filterFindingsFixedInDiff)","requiresPath":"(?:^|/)pipeline\\.mjs$"}
{"id":"crosschunk-emitBlast-dropAmbiguous","description":"кросс-чанк: emitBlastRadiusFindings уже читает dropAmbiguous (dry-run 2026-08-30)","regex":"(?:emitBlastRadiusFindings).{0,80}(?:должен\\s+поддерживать\\s+dropAmbiguous|не\\s+читает\\s+dropAmbiguous|молча\\s+игнорир)|(?:Зависимость:\\s*emitBlastRadiusFindings.{0,40}dropAmbiguous)","requiresPath":"(?:^|/)pipeline\\.mjs$"}
{"id":"test-whitebox-graphify-import","description":"прямой импорт graphify-хелперов в тестах — осознанный white-box (dry-run 2026-08-30)","regex":"(?:[Пп]рямой\\s+импорт\\s+graphify|white-box|обход\\s+barrel(?:\\s+index\\.mjs)?|[Пп]рямой\\s+импорт.{0,40}graphify)","requiresPath":"(?:^|/)test/pr-review\\.test\\.mjs$"}
{"id":"test-fp-import-channels-ok","description":"matchesKnownFalsePositive из barrel + resetFpPatternsCache из модуля — ок для тестов (dry-run 2026-08-30)","regex":"(?:[Нн]есогласованн[а-яё]*\\s+канал\\s+импорта\\s+fp-patterns|matchesKnownFalsePositive.{0,40}resetFpPatternsCache|resetFpPatternsCache.{0,40}matchesKnownFalsePositive)","requiresPath":"(?:^|/)test/pr-review\\.test\\.mjs$"}
{"id":"test-fixture-secrets-ok","description":"фиктивные секреты в unit-тестах redact — не CI-утечка (dry-run 2026-08-30)","regex":"(?:[Фф]иктивн[а-яё]*\\s+секрет|fake\\s+secret|fixture\\s+secret).{0,60}(?:тест|test|CI|лог)|(?:секрет[а-яё]*\\s+в\\s+тестах).{0,40}(?:утекает|leak)","requiresPath":"(?:^|/)test/pr-review\\.test\\.mjs$"}
{"id":"redact-query-ampersand-edge","description":"query-redact по & — стандарт URL-encoding, не дефект (dry-run 2026-08-30)","regex":"(?:Query-регулярка|query.{0,20}(?:&|амперсанд)|обрезает\\s+значение\\s+по\\s+`?&`?).{0,60}(?:редк|edge\\s+case|URL)","requiresPath":"(?:^|/)lib/util\\.mjs$"}
{"id":"escape-md-ticks-intentional","description":"escapeMdTicks удаляет backticks намеренно (anti-injection), trade-off задокументирован (dry-run 2026-08-30)","regex":"(?:escapeMdTicks|безвозвратно\\s+удаляет\\s+backtick|удаляет\\s+backticks).{0,60}(?:caller|symbol|file|искаж)|(?:backtick).{0,40}(?:escapeMdTicks|безвозврат)","requiresPath":"(?:^|/)lib/blast-findings\\.mjs$"}
{"id":"metrics-bymodel-object-contract","description":"aggregateMetrics.byModel: Map→Object — намеренный JSON-friendly контракт (dry-run 2026-08-30)","regex":"(?:[Сс]мена\\s+контракта\\s+aggregateMetrics\\.byModel|byModel:\\s*Map\\s*→\\s*Object|Map\\s*→\\s*Object).{0,40}(?:aggregateMetrics|byModel)|(?:aggregateMetrics).{0,40}(?:Map\\s*→\\s*Object|JSON-friendly)","requiresPath":"(?:^|/)(?:lib/metrics\\.mjs|test/pr-review\\.test\\.mjs)$"}
