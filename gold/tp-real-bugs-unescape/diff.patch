+++ b/ops/observability/hermes/systemd/hermes-docker-health-exporter
@@ -0,0 +1,55 @@
+#!/bin/sh
+# Prometheus textfile collector: compact health/restart metrics for critical Hermes containers.
+set -eu
+
+metric_dir=/var/lib/node_exporter/textfile
+metric_file="$metric_dir/hermes_docker.prom"
+tmp_file=$(mktemp "$metric_dir/.hermes_docker.XXXXXX")
+trap 'rm -f "$tmp_file"' EXIT
+
+containers='
+observability-loki-1
+observability-prometheus-1
+observability-grafana-1
+  observability-uptime-kuma-1
+  langfuse-clickhouse-1
+  langfuse-langfuse-web-1
+  langfuse-langfuse-worker-1
+  langfuse-minio-1
+  langfuse-postgres-1
+  langfuse-redis-1
+  gw-replica-db
+  dev-minio
+dev-mailpit
+gateway-integrator-sandbox-caddy-1
+gateway-integrator-sandbox-api-gateway-1
+gateway-integrator-sandbox-gateway-core-1
+gateway-integrator-sandbox-timescaledb-1
+'
+
+{
+  echo '# HELP hermes_docker_container_running 1 when a monitored container is running.'
+  echo '# TYPE hermes_docker_container_running gauge'
+  echo '# HELP hermes_docker_container_unhealthy 1 when a monitored container healthcheck is unhealthy.'
+  echo '# TYPE hermes_docker_container_unhealthy gauge'
+  echo '# HELP hermes_docker_container_restarts_total Docker restart count for a monitored container.'
+  echo '# TYPE hermes_docker_container_restarts_total counter'
+
+  for container in $containers; do
+    state=$(docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null || printf missing)
+    health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container" 2>/dev/null || printf missing)
+    restarts=$(docker inspect --format '{{.RestartCount}}' "$container" 2>/dev/null || printf 0)
+
+    running=0
+    unhealthy=0
+    [ "$state" = running ] && running=1
+    [ "$health" = unhealthy ] && unhealthy=1
+
+    printf 'hermes_docker_container_running{container="%s"} %s\n' "$container" "$running"
+    printf 'hermes_docker_container_unhealthy{container="%s"} %s\n' "$container" "$unhealthy"
+    printf 'hermes_docker_container_restarts_total{container="%s"} %s\n' "$container" "$restarts"
+  done
+} > "$tmp_file"
+
+chmod 0644 "$tmp_file"
+mv "$tmp_file" "$metric_file"
