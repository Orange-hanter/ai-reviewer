+"""CLI: ``cod-doc structure`` — snapshots, drift, triage, waivers, replay."""
+
+from __future__ import annotations
+
+import json as _json
+import sys
+from datetime import datetime
+from pathlib import Path
+from typing import TYPE_CHECKING
