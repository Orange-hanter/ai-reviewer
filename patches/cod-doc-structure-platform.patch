+def ctx_structure(
+    ctx: click.Context,
+    project: str,
+    head_sha: str | None,
+    snapshot_fingerprint: str | None,
+    scope_refs: tuple[str, ...],
+    budget_tokens: int,
+    dependency_depth: int,
+) -> None:
+    """Pinned BFS structure slice. Requires head SHA or snapshot fingerprint."""
