+
+test('gen-api-doc: шапка без числовой версии — ошибка, а не молчаливый откат к 1.0', () => {
+  const broken = planDoc({ existing: null, byRoute: BASE_ROUTES, today: '2026-01-01' })
+    .content.replace('Версия: 1.0\n', '');
+
+  assert.throws(() => planDoc({ existing: broken, byRoute: BASE_ROUTES, today: '2026-01-01' }), /Версия:/);
+});
+
+test('gen-api-doc: пустая строка внутри таблицы changelog не теряет прежние записи', () => {
+  const withGap = [
+    '## Changelog',
+    '',
+    '| Версия | Дата | Изменение |',
+    '|--------|------|-----------|',
+    '| 1.1 | 2026-02-02 | вторая |',
+    '',
+    '| 1.0 | 2026-01-01 | первая |',
+    '',
+  ].join('\n');
+
+  assert.deepEqual(parseChangelogRows(withGap), ['| 1.1 | 2026-02-02 | вторая |', '| 1.0 | 2026-01-01 | первая |']);
