{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange-hanter.github.io/ai-reviewer/schemas/obligations-export.v1.schema.json",
  "title": "cod-doc obligations export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaRef", "version", "kind", "project", "revision", "exportedAt", "obligations"],
  "properties": {
    "schemaRef": { "const": "code-structure/obligations-export.v1" },
    "version": { "const": 1 },
    "kind": { "const": "obligations_export" },
    "project": { "type": "string", "minLength": 1, "maxLength": 200 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "headSha": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{7,64}$" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "obligations": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/obligation" }
    }
  },
  "$defs": {
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "contentHash",
        "priority",
        "kind",
        "statement",
        "status",
        "contractRefs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source": {
          "enum": ["cod-doc-section", "story-acceptance", "task-acceptance", "derived-from-contract"]
        },
        "docRef": { "type": ["string", "null"], "maxLength": 500 },
        "sectionAnchor": { "type": ["string", "null"], "maxLength": 300 },
        "storyRef": { "type": ["string", "null"], "maxLength": 300 },
        "taskRef": { "type": ["string", "null"], "maxLength": 300 },
        "moduleRef": { "type": ["string", "null"], "maxLength": 300 },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "priority": { "enum": ["must", "should", "may"] },
        "kind": {
          "enum": ["happy_path", "error_path", "boundary_value", "invariant", "integration", "compatibility"]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "status": { "enum": ["draft", "confirmed"] },
        "contractRefs": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "uniqueItems": true
        },
        "expected": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "provenance": {
          "enum": ["manual", "agent", "import"]
        }
      }
    }
  }
}
