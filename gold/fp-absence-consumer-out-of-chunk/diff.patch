+  // где регистр значим (`a.ts` и `A.ts` — разные файлы на case-sensitive ФС).
+  return `${f?.model || ''}|${String(f?.file || '').trim()}|${Number(f?.line) || 0}|${f?.severity || ''}|${title}`;
