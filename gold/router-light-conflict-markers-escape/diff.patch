@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Единственный санкционированный путь merge для агентов: гейт → merge.
+#
+# Аудит #504 §6.3: «процессный gate слабее CI check» — правило «не мержить без
+# pr-merge-ready.sh» было записано в скиллах, но ничем не исполнялось, и PR уезжали
+# в main с незакрытыми blocking-тредами (#475/#487/#490/#496). Здесь оно исполняется:
+# без зелёного ops/pr-merge-ready.sh merge не произойдёт — скрипт выйдет ≠0.
+#
+#   ./ops/pr-merge.sh                 # PR текущей ветки, merge-commit
+#   ./ops/pr-merge.sh 519             # конкретный PR
+#   ./ops/pr-merge.sh 519 --squash --delete-branch
+#
+# Обхода нет: если находки уже разобраны, но тред висит — закрой тред, а не гейт.
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+
+if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
+  echo "Usage: $0 [pr-number] [gh pr merge flags…]"
+  exit 0
+fi
+
+command -v gh >/dev/null 2>&1 || { echo "pr-merge: нужен gh CLI" >&2; exit 127; }
+
+PR=""
+if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
+  PR="$1"; shift
+else
+  PR="$(gh pr view --json number -q .number 2>/dev/null || true)"
+fi
+if [ -z "$PR" ]; then
+  echo "pr-merge: не понял, какой PR мержить (передай номер)" >&2
+  exit 2
+fi
+
+echo "pr-merge: гейт merge-ready для PR #${PR}…"
+if ! "$ROOT/ops/pr-merge-ready.sh" "$PR"; then
+  echo "" >&2
+  echo "pr-merge: MERGE НЕ ВЫПОЛНЕН — гейт красный (см. причины выше)." >&2
+  echo "  · красный CI → ./ops/ci-watch.sh $PR, чинить и пушить" >&2
+  echo "  · unresolved blocking threads → ./ops/ai-review-status.sh $PR, разобрать и закрыть" >&2
+  exit 1
+fi
+
+# Метод merge по умолчанию — merge-commit (так выглядит история main).
+METHOD_GIVEN=0
+for arg in "$@"; do
+  case "$arg" in
+    --squash|--rebase|--merge) METHOD_GIVEN=1 ;;
+  esac
+done
+if [ "$METHOD_GIVEN" -eq 0 ]; then
+  set -- "$@" --merge
+fi
+
+echo "pr-merge: гейт зелёный → gh pr merge $PR $*"
+gh pr merge "$PR" "$@"
