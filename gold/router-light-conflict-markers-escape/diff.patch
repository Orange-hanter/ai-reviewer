+#!/usr/bin/env bash
+# Тест ops/pr-merge.sh без сети: `gh` подменён стабом в PATH. Внутри работает НАСТОЯЩИЙ
+# ops/pr-merge-ready.sh — проверяем сцепку «гейт → merge», а не мок гейта.
+#
+#   ./ops/pr-merge.test.sh
+set -uo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+SCRIPT="$ROOT/ops/pr-merge.sh"
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+
+bash -n "$SCRIPT" || { echo "pr-merge.test: синтаксис $SCRIPT"; exit 1; }
+
+FAKE_BIN="$TMP/bin"; mkdir -p "$FAKE_BIN"
+MERGE_LOG="$TMP/merge.log"
+
+# Стаб gh: сценарий задаётся через FAKE_CHECKS / FAKE_MERGEABLE / FAKE_THREADS.
+cat > "$FAKE_BIN/gh" <<'STUB'
+#!/usr/bin/env bash
+ARGS="$*"
+case "$ARGS" in
+  "repo view "*) echo '{"nameWithOwner":"o/r"}'; [[ "$ARGS" == *"-q"* ]] && echo "o/r"; exit 0 ;;
+esac
+if [[ "$ARGS" == "pr view --json number"* ]]; then echo "519"; exit 0; fi
+if [[ "$ARGS" == *"--json mergeable,mergeStateStatus"* ]]; then
+  echo "${FAKE_MERGEABLE:-MERGEABLE CLEAN}"; exit 0
+fi
+if [[ "$ARGS" == *"--json reviewDecision"* ]]; then echo "${FAKE_DECISION:-APPROVED}"; exit 0; fi
+if [[ "$ARGS" == "pr checks"* ]]; then
+  if [ "${FAKE_CHECKS:-pass}" = "pass" ]; then echo "Tests + build	pass	1m"; exit 0; fi
+  echo "Tests + build	fail	1m"; exit 1
+fi
+if [[ "$ARGS" == "api graphql"* ]]; then
+  if [ "${FAKE_THREADS:-none}" = "blocking" ]; then
+    echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[{"isResolved":false,"comments":{"nodes":[{"body":"<!-- orakul-ai-review-inline -->\n**major**: RBAC"}]}}]}}}}}'
+  else
+    echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[]}}}}}'
+  fi
+  exit 0
+fi
+if [[ "$ARGS" == "pr merge"* ]]; then echo "$ARGS" >> "$MERGE_LOG"; echo "merged"; exit 0; fi
+exit 0
+STUB
+chmod +x "$FAKE_BIN/gh"
+export MERGE_LOG
+
+PASS=0; FAIL=0
+run() { # run <описание> [VAR=val …] -- [аргументы pr-merge.sh]
+  CASE="$1"; shift
+  : > "$MERGE_LOG"
+  local envs=(); while [ "${1:-}" != "--" ] && [ $# -gt 0 ]; do envs+=("$1"); shift; done; shift || true
+  OUT="$(env PATH="$FAKE_BIN:$PATH" MERGE_LOG="$MERGE_LOG" ${envs[@]+"${envs[@]}"} bash "$SCRIPT" "$@" 2>&1)"
+  RC=$?
+}
+check() {
+  if [ "$2" = "$3" ]; then PASS=$((PASS+1)); printf '  ✓ %s: %s\n' "$CASE" "$1";
+  else FAIL=$((FAIL+1)); printf '  ✗ %s: %s\n    ожидали: %s\n    получили: %s\n--- вывод ---\n%s\n' "$CASE" "$1" "$2" "$3" "$OUT"; fi
+}
+merged() { tr -d '\n' < "$MERGE_LOG"; }
+
+echo "pr-merge: тесты"
+
+run 'гейт зелёный' -- 519
+check 'rc' 0 "$RC"
+check 'смержили merge-коммитом' 'pr merge 519 --merge' "$(merged)"
+
+run 'явный метод не перетирается' -- 519 --squash --delete-branch
+check 'rc' 0 "$RC"
+check 'флаги пользователя' 'pr merge 519 --squash --delete-branch' "$(merged)"
+
+run 'красный CI' FAKE_CHECKS=fail -- 519
+check 'rc' 1 "$RC"
+check 'merge не вызывался' '' "$(merged)"
+
+run 'висит blocking-тред' FAKE_THREADS=blocking -- 519
+check 'rc' 1 "$RC"
+check 'merge не вызывался' '' "$(merged)"
+
+run 'конфликт в PR' FAKE_MERGEABLE='CONFLICTING DIRTY' -- 519
+check 'rc' 1 "$RC"
+check 'merge не вызывался' '' "$(merged)"
+
+run 'человек запросил изменения' FAKE_DECISION=CHANGES_REQUESTED -- 519
+check 'rc' 1 "$RC"
+check 'merge не вызывался' '' "$(merged)"
+
+# --- хук Claude Code: сырой gh pr merge должен блокироваться (exit 2) ---
+HOOK="$ROOT/ops/hooks/deny-raw-pr-merge.sh"
+bash -n "$HOOK" || { echo "pr-merge.test: синтаксис $HOOK"; exit 1; }
+hook() { # hook <описание> <json> <ожидаемый rc>
+  CASE="$1"
+  OUT="$(printf '%s' "$2" | bash "$HOOK" 2>&1)"; RC=$?
+  check 'rc хука' "$3" "$RC"
+}
+hook 'хук: сырой merge'      '{"tool_name":"Bash","tool_input":{"command":"gh pr merge 519 --squash"}}' 2
+hook 'хук: merge в цепочке'  '{"tool_name":"Bash","tool_input":{"command":"cd Orakul && gh pr merge 519"}}' 2
+hook 'хук: врапер разрешён'  '{"tool_name":"Bash","tool_input":{"command":"./ops/pr-merge.sh 519 --merge"}}' 0
+hook 'хук: чтение разрешено' '{"tool_name":"Bash","tool_input":{"command":"gh pr view 519"}}' 0
+hook 'хук: другой инструмент' '{"tool_name":"Read","tool_input":{"file_path":"gh pr merge"}}' 0
+hook 'хук: мусор на входе'   'not json' 0
+
+echo
+echo "pr-merge: $PASS ok, $FAIL fail"
+[ "$FAIL" -eq 0 ] || exit 1
