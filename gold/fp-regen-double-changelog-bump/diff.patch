+// ------------------------------------------------------- сквозной прогон скрипта
+
+function makeTree() {
+  // realpath: на macOS os.tmpdir() — симлинк /var → /private/var, и запуск скрипта по
+  // несимлинкнутому пути разошёлся бы с его же import.meta.url (main просто не стартовал бы).
+  const dir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'gen-api-doc-')));
+  fs.mkdirSync(path.join(dir, 'ops'), { recursive: true });
+  fs.mkdirSync(path.join(dir, 'app/server'), { recursive: true });
+  fs.mkdirSync(path.join(dir, 'docs/dev/reference'), { recursive: true });
+  // ROOT генератора выводится из его собственного пути — копии в дереве-макете хватает.
+  fs.copyFileSync(GEN_SRC, path.join(dir, 'ops/gen-api-routes-doc.mjs'));
+  fs.writeFileSync(path.join(dir, 'app/server/records.ts'), "app.get('/api/records', h);\napp.post('/api/records', h);\n");
+  return dir;
+}
+
+function run(dir, ...args) {
+  const res = spawnSync(process.execPath, [path.join(dir, 'ops/gen-api-routes-doc.mjs'), ...args], {
+    encoding: 'utf8',
+  });
+  return { code: res.status, out: res.stdout ?? '', err: res.stderr ?? '' };
+}
+
+const readDoc = (dir) => fs.readFileSync(path.join(dir, 'docs/dev/reference/api-endpoints-index.md'), 'utf8');
+const writeDoc = (dir, text) => fs.writeFileSync(path.join(dir, 'docs/dev/reference/api-endpoints-index.md'), text);
+
+// Сквозные проверки читают документ своими руками, а не парсерами генератора: иначе на
+// сломанном генераторе они падали бы «функции нет», а должны падать на самом поведении.
+const versionOf = (text) => /^Версия:[ \t]*(\S+)[ \t]*$/m.exec(text)?.[1] ?? null;
+const rowsOf = (text) => text.split('\n').filter((l) => /^\| \d+(\.\d+)* \| \d{4}-\d{2}-\d{2} \|/.test(l));
+
+test('gen-api-doc e2e: новый роут → --check красный, регенерация поднимает версию и снова зелено', (t) => {
+  const dir = makeTree();
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+
+  assert.equal(run(dir).code, 0);
+  assert.equal(versionOf(readDoc(dir)), '1.0');
+
+  const fresh = run(dir, '--check');
+  assert.equal(fresh.code, 0, fresh.err);
+  assert.equal(run(dir).out.startsWith('Unchanged'), true);
+
+  fs.writeFileSync(path.join(dir, 'app/server/voucher.ts'), "app.get('/api/voucher/summary', h);\n");
+
+  const stale = run(dir, '--check');
+  assert.equal(stale.code, 1);
+  assert.match(stale.err, /Stale/);
+
+  assert.equal(run(dir).code, 0);
+  const bumped = readDoc(dir);
+  assert.equal(versionOf(bumped), '1.1');
+  assert.equal(rowsOf(bumped).length, 2);
+  assert.ok(bumped.includes('`/api/voucher/summary`'));
+
+  const after = run(dir, '--check');
+  assert.equal(after.code, 0, after.err);
+});
+
+test('gen-api-doc e2e: устаревшие даты в файле не делают --check красным и не переписывают файл', (t) => {
+  const dir = makeTree();
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+
+  run(dir);
+  const stale = readDoc(dir).replace(/\d{4}-\d{2}-\d{2}/g, '2020-01-01');
+  writeDoc(dir, stale);
+
+  const check = run(dir, '--check');
+  assert.equal(check.code, 0, check.err);
+
+  assert.match(run(dir).out, /^Unchanged/);
+  assert.equal(readDoc(dir), stale); // ни версии, ни даты не тронуты — иначе гейт краснел бы на пустом месте
+});
+
+test('gen-api-doc e2e: стёртая строка `Версия:` — красный выход с внятным сообщением', (t) => {
+  const dir = makeTree();
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+
+  run(dir);
+  writeDoc(dir, readDoc(dir).replace('Версия: 1.0\n', ''));
+
+  const res = run(dir);
+  assert.equal(res.code, 1);
+  assert.match(res.err, /Версия:/);
+  assert.doesNotMatch(readDoc(dir), /^Версия:/m); // файл не переписан «на глазок»
+});
+
+test('gen-api-doc e2e: --check без файла — красный', (t) => {
+  const dir = makeTree();
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+
+  const res = run(dir, '--check');
+  assert.equal(res.code, 1);
+  assert.match(res.err, /Missing/);
+});
